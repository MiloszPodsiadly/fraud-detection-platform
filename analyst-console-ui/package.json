{
  "name": "analyst-console-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "generate:authorities": "node ../scripts/generate-frontend-authorities.mjs",
    "check:authorities": "node ../scripts/generate-frontend-authorities.mjs --check",
    "check:api-client-boundary": "node ../scripts/check-fdp48-api-client-boundary.mjs",
    "check:auth-sensitive-api-boundary": "node ../scripts/check-auth-sensitive-api-boundary.mjs",
    "check:workspace-api-client-boundary": "node ../scripts/check-api-client-boundary.mjs",
    "check:scope:api-client": "node ../scripts/check-api-client-scope.mjs",
    "check:scope:workspace-runtime": "node ../scripts/check-workspace-runtime-scope.mjs",
    "check:scope:workspace-detail": "node ../scripts/check-workspace-detail-scope.mjs",
    "check:scope:workspace-runtime-ownership": "node ../scripts/check-workspace-runtime-ownership-scope.mjs",
    "dev": "npm run generate:authorities && vite --host 127.0.0.1",
    "build": "npm run generate:authorities && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run generate:authorities && vitest run"
  },
  "dependencies": {
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.29",
    "undici": "8.11.2",
    "minimist": "1.2.8",
    "ws": "8.22.0",
    "source-map-js": "1.2.2"
  }
}
