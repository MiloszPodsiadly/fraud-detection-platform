    "imageSbomBomFormat": "CycloneDX",
    "trivyImageSchemaVersion": 2,
    "packageUrlPrefix": "pkg:"
  },
  "imageIdentity": {
    "evidenceSchemaVersion": 3,
    "allowedSources": ["buildx-loaded-image", "registry-pinned"],
    "dockerImageIdKinds": ["config-digest", "manifest-descriptor", "source-index-descriptor"],
    "manifestMediaTypes": [
      "application/vnd.oci.image.manifest.v1+json",
      "application/vnd.docker.distribution.manifest.v2+json"
    ],
    "indexMediaTypes": [
      "application/vnd.oci.image.index.v1+json",
      "application/vnd.docker.distribution.manifest.list.v2+json"
    ],
    "sbomPropertyPrefix": "fraud-detection-platform:"
  },
  "platformGate": {
    "artifactName": "platform-security-evidence",
    "requiredProducerJobs": [
      "backend",
      "graph-signed-e2e",
      "institutional-reliability",
      "fdp42-fraud-case-management",
      "fdp45-fraud-case-work-queue-read-model",
      "ml",
      "frontend",
      "frontend-dependency-audit",
      "python-dependency-audit",
      "fdp28-proof",
      "fdp35-production-readiness",
      "fdp47-analyst-console-ux-and-summary",
      "fdp48-bff-session-request-lifecycle",
      "security-route-boundary",
      "fdp54-ci-docs-governance",
      "analyst-console-frontend-architecture-gate",
      "regulated-mutation-regression",
      "fdp36-real-chaos",
      "fdp37-production-image-chaos",
      "fdp38-live-runtime-checkpoint-chaos",
      "fdp39-release-governance",
      "fdp40-release-controls",
      "fdp-image-scan-evidence",
      "docker",
      "compose-ci",
      "resolved-sbom"
    ],
    "requiredArtifactBases": [
      "npm-audit",
      "pip-audit",
      "repository-config-scan",
      "repository-vulnerability-evidence",
      "repository-secret-proof",
      "resolved-cyclonedx-sbom",
      "image-scan-validation",
      "fdp-image-scan-validation"
    ],
    "historicalImageArtifacts": [
      "fdp37-alert-service-image-security",
      "fdp38-alert-service-fixture-image-security",
      "fdp39-release-image-security",
      "fdp39-fixture-image-security"
    ],
    "imageValidationJobs": {
      "inventory": ["backend-images", "service-images", "infrastructure-images"],
      "historical": ["fdp37", "fdp38", "fdp39"]
    },
    "requiredFiles": {
      "npmAudit": "npm-audit.json",
      "pythonAudit": "pip-audit.json",
      "repositoryConfig": "trivy-config.json",
      "secretProof": "secret-proof-summary.json",
      "vulnerabilityCombined": "combined.json",
      "vulnerabilitySummary": "summary.json",
      "vulnerabilityRepositoryReport": "repository.json",
      "vulnerabilityMavenReport": "resolved-maven.json",
      "imageValidationSummary": "validated-image-scan-summary.json",
      "sbomDocuments": [
        "maven-resolved.cdx.json",
        "npm-analyst-console-ui.cdx.json",
        "python-ml-inference-service.cdx.json",
        "npm-sbom-toolchain-audit.json"
      ]
    }
  },
  "vulnerabilityPolicy": {
    "visibleSeverities": ["UNKNOWN", "LOW", "MEDIUM", "HIGH", "CRITICAL"],
    "blockingSeverities": ["HIGH", "CRITICAL"],
    "npmBlockingSeverities": ["high", "critical"],
    "secretTimeout": "10m",
    "repositoryTimeout": "10m",
    "imageTimeout": "15m"
  },
  "processLimits": {
    "mavenResolutionAttempts": 3,
    "mavenResolutionTotalMs": 900000,
    "mavenProcessMs": 300000,
    "mavenRetryWaitMs": 300000,
    "mavenBackoffMaxMs": 15000,
    "secretProofTotalMs": 300000,
    "secretVersionProcessMs": 30000,
    "secretMavenProcessMs": 90000,
    "secretScanProcessMs": 180000,
    "secretScanCliTimeout": "2m"
  },
  "secretProof": {
    "expectedRuleId": "aws-access-key-id",
    "expectedSeverity": "CRITICAL",
    "expectedFindingCount": 1
  },
  "artifacts": {
    "retentionDays": 30,
    "imageSecuritySuffix": "security",
    "imageEvidenceFiles": {
      "evidence": "image-security-evidence.json",
      "dockerInspect": "docker-image-inspect.json",
      "dockerInspectAfterScan": "docker-image-inspect-after-scan.json",
      "scanResult": "image-scan-result.json",
      "trivy": "trivy-image.json",
      "rawSbom": "image.cdx.raw.json",
      "boundSbom": "image.cdx.json",
      "buildxMetadata": "buildx-metadata.json",
      "registryIdentity": "registry-image-identity.json"
    }
  },
