# Committed local runtime fixture template. Values below are for Docker demo/evaluation only.
# This file does not configure an institutional deployment or provision its external trust dependencies.
INTERNAL_AUTH_TOKEN=local-dev-internal-token
# SHA-256 of INTERNAL_AUTH_TOKEN for the optional TOKEN_VALIDATOR override.
INTERNAL_AUTH_TOKEN_SHA256=486c7e8132888f1bbc9cb9165533394615e283500a51bfdfee509e8fe42b869a
INTERNAL_AUTH_JWT_SECRET=local-dev-jwt-service-secret-32bytes
TRUST_AUTHORITY_HMAC_SECRET=local-dev-trust-hmac-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional direct bearer-token API validation settings (non-secret examples).
# Protected deployments must set issuer and expected audience, and the IdP must issue both claims.
# APP_SECURITY_JWT_ENABLED=true
# APP_SECURITY_JWT_REQUIRED=true
# APP_SECURITY_JWT_ISSUER_URI=https://identity.example.test/realms/fraud-detection
# APP_SECURITY_JWT_EXPECTED_AUDIENCE=fraud-detection-platform-api
# APP_SECURITY_JWT_JWK_SET_URI=https://identity.example.test/realms/fraud-detection/protocol/openid-connect/certs
# JWKS-only omits trusted issuer binding and is permitted only as an explicit local/test fixture mode.
# APP_SECURITY_JWT_ALLOW_UNBOUND_JWKS_FOR_LOCAL=true

# Optional local development tuning.
MODEL_PROMOTION_API_RATE_LIMITER_MODE=redis
# Compose uses the plain docker profile, which requires Redis; in-memory needs an explicit allowlisted local profile.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=5m
AUTO_REPLAY_ENABLED=true
AUTO_REPLAY_SOURCE_TYPE=SYNTHETIC
AUTO_REPLAY_MAX_EVENTS=50000
AUTO_REPLAY_THROTTLE_MILLIS=5
AUTO_REPLAY_START_DELAY_MILLIS=15000

# Canonical transactional outbox tuning.
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_RECOVERY_ENABLED=true
OUTBOX_LEASE_DURATION=PT1M
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_STALE_THRESHOLD=PT10M
OUTBOX_PUBLISHER_DELAY_MS=5000
OUTBOX_RECOVERY_STALE_PROCESSING_THRESHOLD=PT2M

# Keep object-store startup validation enabled unless a reviewed local-only setup requires otherwise.
AUDIT_EXTERNAL_ANCHORING_OBJECT_STORE_STARTUP_CHECK_ENABLED=true

# Institutional deployment examples only; these are intentionally unset and are not wired by the local Compose stack.
# Set them through the protected deployment environment after provisioning reviewed public trust registries.
# AUDIT_BANK_MODE_FAIL_CLOSED=true
# APP_SECURITY_JWT_ENABLED=true
# APP_SECURITY_JWT_REQUIRED=true
# APP_SECURITY_JWT_ISSUER_URI=https://identity.example.test/realms/fraud-detection
# APP_SECURITY_JWT_EXPECTED_AUDIENCE=fraud-detection-platform-api
# SENSITIVE_READS_AUDIT_FAIL_CLOSED=true
# APP_MODEL_POLICY_WEBAUTHN_RP_ID=fraud.example.test
# APP_MODEL_POLICY_WEBAUTHN_ORIGIN=https://fraud.example.test
# MODEL_PROMOTION_TRUSTED_ISSUERS_PATH=/run/model-promotion-trust/trusted-issuers.json
# MODEL_PROMOTION_APPROVAL_TRUST_PATH=/run/model-promotion-trust/trusted-approvals.json
# MODEL_PROMOTION_ONLINE_ACTOR_TRUST_PATH=/run/model-promotion-trust/online-actor-trust.json
# MODEL_PROMOTION_TRUST_MIN_GENERATION=<independently-protected-floor>
# MODEL_PROMOTION_APPROVAL_TRUST_MIN_GENERATION=<independently-protected-floor>
# MODEL_PROMOTION_ONLINE_ACTOR_TRUST_MIN_GENERATION=<independently-protected-floor>
# MODEL_PROMOTION_PERSISTENCE_ENABLED=true
# REGULATED_MUTATIONS_TRANSACTION_MODE=REQUIRED
# MODEL_PROMOTION_API_RATE_LIMITER_MODE=redis
