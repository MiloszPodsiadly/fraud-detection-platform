{
  "schemaVersion": 1,
  "tools": {
    "node": "26.13.1",
    "npm": "12.2.3",
    "python": "3.12.16",
    "pip": "26.3",
    "pipAudit": "2.10.1",
    "trivy": "0.76.2",
    "syft": "1.57.2",
