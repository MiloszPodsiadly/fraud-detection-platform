# syntax=docker/dockerfile:1.29@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

FROM maven:3.10.2-eclipse-temurin-21-noble@sha256:c8d5fcc6bbda32e415cd6a2f4d091c52f768e12594cfdb396dd2712c4b609369 AS build
COPY scripts/ci/verify-temurin-java-runtime.sh /usr/local/bin/verify-temurin-java-runtime
RUN chmod 0555 /usr/local/bin/verify-temurin-java-runtime && /usr/local/bin/verify-temurin-java-runtime
COPY scripts/ci/exec-with-verified-temurin-java.sh /usr/local/bin/exec-with-verified-temurin-java
RUN chmod 0555 /usr/local/bin/exec-with-verified-temurin-java

ARG MODULE_NAME

WORKDIR /workspace

COPY pom.xml .
COPY common-events/pom.xml common-events/pom.xml
COPY source-persistence/pom.xml source-persistence/pom.xml
COPY common-test-support/pom.xml common-test-support/pom.xml
COPY transaction-ingest-service/pom.xml transaction-ingest-service/pom.xml
COPY transaction-simulator-service/pom.xml transaction-simulator-service/pom.xml
COPY feature-enricher-service/pom.xml feature-enricher-service/pom.xml
COPY fraud-scoring-service/pom.xml fraud-scoring-service/pom.xml
COPY alert-service/pom.xml alert-service/pom.xml
COPY audit-trust-authority/pom.xml audit-trust-authority/pom.xml
COPY model-promotion-policy-publisher/pom.xml model-promotion-policy-publisher/pom.xml

RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -B -ntp -pl "${MODULE_NAME}" -am -Dmaven.test.skip=true dependency:go-offline

COPY common-events/src common-events/src
COPY source-persistence/src source-persistence/src
COPY common-test-support/src common-test-support/src
COPY transaction-ingest-service/src transaction-ingest-service/src
COPY transaction-simulator-service/src transaction-simulator-service/src
COPY feature-enricher-service/src feature-enricher-service/src
COPY fraud-scoring-service/src fraud-scoring-service/src
COPY alert-service/src alert-service/src
COPY audit-trust-authority/src audit-trust-authority/src
COPY model-promotion-policy-publisher/src model-promotion-policy-publisher/src

RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -B -ntp -pl "${MODULE_NAME}" -am -Dmaven.test.skip=true package

FROM eclipse-temurin:21.0.13.1_2-jre-noble@sha256:897ec01ae1350622de0d5393a48a4ffffee8fe1609f248f4389578b919eaf9f5
COPY scripts/ci/verify-temurin-java-runtime.sh /usr/local/bin/verify-temurin-java-runtime
RUN chmod 0555 /usr/local/bin/verify-temurin-java-runtime && /usr/local/bin/verify-temurin-java-runtime
COPY scripts/ci/exec-with-verified-temurin-java.sh /usr/local/bin/exec-with-verified-temurin-java
RUN chmod 0555 /usr/local/bin/exec-with-verified-temurin-java

ARG MODULE_NAME

ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build /workspace/${MODULE_NAME}/target/*-exec.jar app.jar

USER 10001:10001

EXPOSE 8080

CMD ["/usr/local/bin/exec-with-verified-temurin-java", "-jar", "/app/app.jar"]
