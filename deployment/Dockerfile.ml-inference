# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM python:3.12.16-slim-trixie@sha256:a0e2dd78cc679ddfffea960fe45ecfcff9ac2f68d67917a0edfcde5c2100151b

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:${PATH}"
ENV FRAUD_FEATURE_CONTRACT_PATH="/app/contracts/fraud-feature-contract.json"

WORKDIR /app

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app app \
    && python -m venv /opt/venv

COPY ml-inference-service/requirements.txt /app/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip==26.3 \
    && python -m pip install --require-hashes --only-binary=:all: -r /app/requirements.txt

COPY --chown=10001:10001 common-events/src/main/resources/feature-contract/fraud-feature-contract.json /app/contracts/fraud-feature-contract.json
COPY --chown=10001:10001 ml-inference-service/app /app/app

USER 10001:10001

EXPOSE 8090

CMD ["python", "-m", "app.server"]
